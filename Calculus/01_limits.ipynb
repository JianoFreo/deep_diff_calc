   "source": [
    "# Hole in the graph\n",
    "\n",
    "## y = $\\frac{3(x-2)}{x-2}$"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "9c391ab1",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "y_right = 3.0\n",
      "y_left = 3.0\n"
     ]
    }
   ],
   "source": [
    "x = 2\n",
    "h = 0.00001\n",
    "\n",
    "y_right =(3*((x+h)-2) )/( (x+h) - 2)\n",
    "y_left=(3*((x-h)-2))/((x-h) - 2)\n",
    "\n",
    "print(\"y_right =\", y_right)\n",
    "print(\"y_left =\", y_left)\n",
    "\n",
    "if round(y_right) != round(y_left):\n",
    "    print(\"Limit does not exist at x = \", x)"
   ]
  },
